# Copy to .env and edit. Every line is optional — the defaults work as-is.
# Real environment variables always win over this file.

# ---- where the agent keeps things ----
# Move everything at once:
# AGENT_DATA_DIR=./data
# Or point just the file sandbox somewhere else:
# AGENT_WORKSPACE=~/Documents/agent-workspace
# AGENT_DB=./data/agent.db
# AGENT_KB=./data/knowledge.db
# AGENT_GUARD_LOG=./data/guard_log.jsonl
# AGENT_MCP_CONFIG=./mcp_servers.json

# ---- the model ----
# OLLAMA_URL=http://localhost:11434
# AGENT_MODEL=qwen3:4b
# AGENT_EMBED_MODEL=nomic-embed-text
# AGENT_NUM_CTX=16384
# AGENT_MAX_REPLY_TOKENS=1024
# AGENT_THINKING=0

# ---- behaviour ----
# readonly = nothing can change, ask = confirm writes and deletes,
# auto = confirm deletes only, open = never ask
# AGENT_GUARD_MODE=ask
# AGENT_MAX_STEPS=10
# AGENT_MAX_TOOL_CALLS=25
